# Copy to .env, then edit. Never commit .env.
# The container only needs these two; Google/Telegram keys live in ./config
# (copied there by `502drive setup`, never in the image or in this file).

# Timezone for schedules and the Telegram/daily reports.
TZ=Asia/Ho_Chi_Minh

# Config JSON inside the container (the ./config mount from compose).
DRIVE502_CONFIG=/config/config.json

# Example of a real-looking but FAKE value shape (setup validates and copies
# secrets privately, so you normally never put them here):
# GOOGLE_OAUTH_CLIENT_ID=000000000000-example.apps.googleusercontent.com
