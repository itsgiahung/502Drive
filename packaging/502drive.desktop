[Desktop Entry]
Version=1.0
Name=502Drive
GenericName=502Drive
GenericName[vi]=502Drive
Comment=Local-first Google Drive sync and clone tool
Comment[vi]=Công cụ đồng bộ và sao chép Google Drive chạy cục bộ
Exec=502drive-gui
Icon=502drive
StartupWMClass=502Drive
Terminal=false
Type=Application
Categories=Utility;Network;FileTransfer;
StartupNotify=true
Keywords=502;502drive;drive;google;sync;clone;telegram;gdclone;
Actions=Dashboard;Doctor;RestartService;ViewLogs;OpenTelegram;

[Desktop Action Dashboard]
Name=Mở 502Drive
Name[en]=Open 502Drive
Exec=502drive-gui

[Desktop Action Doctor]
Name=Kiểm tra hệ thống (Doctor)
Name[en]=System Health Check (Doctor)
Exec=ptyxis --title "502Drive Doctor" -- 502drive doctor

[Desktop Action RestartService]
Name=Khởi động lại dịch vụ 502Drive
Name[en]=Restart 502Drive Service
Exec=systemctl --user restart gdclone-bot

[Desktop Action ViewLogs]
Name=Xem nhật ký hoạt động (Live Logs)
Name[en]=View Live Logs
Exec=ptyxis --title "502Drive Live Logs" -- journalctl --user -u gdclone-bot -f

[Desktop Action OpenTelegram]
Name=Mở Telegram
Name[en]=Open Telegram
Exec=xdg-open "tg://resolve?domain=Drive502_Bot"
